# Backend
PORT=4000
LOG_LEVEL=debug
# Comma-separated list. Leave unset for same-origin in production, open in dev.
# CORS_ORIGIN=https://secretdj.example.com
# Proxy hops in front of the app, so per-IP rate limits see the real client.
TRUST_PROXY_HOPS=1

# Frontend (build time)
# Only needed when the API is served from a different origin than the app.
# VITE_BACKEND_URL=https://api.secretdj.example.com
